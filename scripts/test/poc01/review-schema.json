{
  "schema_version": "swisstip.poc01-gold/v1",
  "columns": [
    "gold_id", "page_id", "source_url", "source_sha256", "split",
    "primary_reviewer", "label", "description", "scope", "conditions",
    "exceptions", "domain", "topic", "supported_operation", "required_context",
    "typed_applicability", "evidence_refs_json", "risk_reason", "first_batch",
    "review_minutes", "same_person_rereviewer", "rereview_decision",
    "rereview_notes", "rereview_minutes", "independent_adjudicator",
    "independent_adjudication", "notes"
  ],
  "required_for_labeled_row": [
    "label", "description", "scope", "conditions", "exceptions", "domain",
    "topic", "supported_operation", "required_context", "typed_applicability",
    "evidence_refs_json", "review_minutes"
  ],
  "evidence_reference": {
    "description": "JSON array of section_id and exact quote. Unique occurrences receive derived offsets at freeze. For ambiguous quotes, supply start/end Unicode character offsets in evidence_text; end is exclusive.",
    "example": [{"section_id": "section-0001", "quote": "Heading"}]
  },
  "first_batch": {"minimum": 10, "maximum": 15, "selection": "Reviewer sets first_batch=yes and supplies risk_reason."},
  "full_gold": {"minimum_per_page": 5, "maximum_per_page": 10},
  "split": "development",
  "primary_reviewer": "user",
  "second_pass": "same-person re-review; not independent adjudication",
  "publication_status": "CANDIDATE; no promotion or evaluation pass implied"
}
