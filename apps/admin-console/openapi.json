  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "ActionRequest"
      },
      "Asset": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "source_id",
          "filename",
          "sha256",
          "origin",
          "size",
          "created_at"
        ],
        "title": "Asset"
      },
      "Catalog": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/Profile"
            },
            "type": "array",
            "title": "Profiles"
          },
          "crawl_profiles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Crawl Profiles"
          },
          "max_pages": {
            "type": "integer",
            "title": "Max Pages"
          },
          "max_requests": {
            "type": "integer",
            "title": "Max Requests"
          }
        },
        "type": "object",
        "required": [
          "sources",
          "profiles",
          "crawl_profiles",
          "max_pages",
          "max_requests"
        ],
        "title": "Catalog"
      },
      "Evidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "original_excerpt": {
            "type": "string",
            "title": "Original Excerpt"
          },
          "citation_url": {
            "type": "string",
            "title": "Citation Url"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "source_id",
          "language",
          "original_excerpt",
          "citation_url"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request"
          },
          "log": {
            "type": "string",
            "title": "Log"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "result_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Sha256"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "cancel_requested": {
            "type": "boolean",
            "title": "Cancel Requested"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "kind",
          "status",
          "request",
          "log",
          "result",
          "error",
          "cancel_requested",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "Job"
      },
      "JobRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "crawl",
              "plan",
              "extract"
            ],
            "title": "Kind"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Source Ids"
          },
          "asset_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Asset Ids"
          },
          "profile": {
            "type": "string",
            "title": "Profile",
            "default": "ollama_local"
          },
          "crawl_profile": {
            "type": "string",
            "const": "smoke",
            "title": "Crawl Profile",
            "default": "smoke"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "JobRequest"
      },
      "Message": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Message"
      },
      "Preview": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections"
          },
          "characters": {
            "type": "integer",
            "title": "Characters"
          },
          "excluded_sections": {
            "type": "integer",
            "title": "Excluded Sections"
          }
        },
        "type": "object",
        "required": [
          "title",
          "language",
          "sections",
          "characters",
          "excluded_sections"
        ],
        "title": "Preview"
      },
      "Profile": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "adapter": {
            "type": "string",
            "title": "Adapter"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "credential_ready": {
            "type": "boolean",
            "title": "Credential Ready"
          },
          "selected": {
            "type": "boolean",
            "title": "Selected"
          }
        },
        "type": "object",
        "required": [
          "name",
          "adapter",
          "model",
          "credential_ready",
          "selected"
        ],
        "title": "Profile"
      },
      "Release": {
        "properties": {
          "release_id": {
            "type": "string",
            "title": "Release Id"
          },
          "classification": {
            "type": "string",
            "title": "Classification"
          },
          "evidence_count": {
            "type": "integer",
            "title": "Evidence Count"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Imported At"
          }
        },
        "type": "object",
        "required": [
          "release_id",
          "classification",
          "evidence_count",
          "imported_at"
        ],
        "title": "Release"
      },
      "ReviewRequest": {
        "properties": {
          "result_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Result Sha256"
          },
          "candidate_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Candidate Id"
          },
          "reviewer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reviewer"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept_draft",
              "reject",
              "needs_changes"
            ],
            "title": "Decision"
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "result_sha256",
          "candidate_id",
          "reviewer",
          "decision"
        ],
        "title": "ReviewRequest"
      },
      "Section": {
        "properties": {
          "section_id": {
            "type": "string",
            "title": "Section Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "section_id",
          "text"
        ],
        "title": "Section"
      },
      "Source": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "scan_status": {
            "type": "string",
            "title": "Scan Status"
          },
          "selected": {
            "type": "boolean",
            "title": "Selected"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "title",
          "language",
          "url",
          "scan_status",
          "selected"
        ],
        "title": "Source"
      },
      "UploadRequest": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Source Id"
          },
          "filename": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Filename"
          },
          "text": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "filename",
          "text"
        ],
        "title": "UploadRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
